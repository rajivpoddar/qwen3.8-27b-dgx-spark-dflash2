# Copy to .env and `source .env` before running anything in bench/.
# serve.sh reads SPARK_API_KEY_FILE, REVISION, DRAFT_REVISION and MAX_RUNNING;
# the rest is for bench/.
export SPARK_BASE_URL=http://localhost:8003/v1
export SPARK_MODEL=qwen3.8-27b
export SPARK_API_KEY_FILE=$HOME/models/vllm_api_key.txt
export SPARK_API_KEY=$(cat $HOME/models/vllm_api_key.txt)
# Keep this explicit so sourcing .env clears a stale high-concurrency value from
# the caller's shell. Four seats preserve the long-context KV pool; use the
# upstream concurrency profiles only for bounded short-context benchmarks.
export MAX_RUNNING=4
# Snapshots every number in this repo was measured on. serve.sh passes them as
# --revision and writes refs/main in the HF cache from them (README, Weights).
export REVISION=554ebba9b5f1b79dc11246341960360e6ef05ef4
export DRAFT_REVISION=bd7a934213c47a9e7ef69eef36bb3325f47fd1f1
